@startuml
title PayLink - Support Employee Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Support Employee" as Support

rectangle "PayLink System" {
  usecase "Search Payment by Reference" as UC_Search
  usecase "View Payment History" as UC_History
  usecase "Block Account" as UC_Block
  usecase "Unblock Account" as UC_Unblock
  usecase "Review Refund Request" as UC_ReviewRefund
  usecase "Approve Refund Request" as UC_ApproveRefund
  usecase "Process Refund" as UC_Refund
  usecase "Generate Reconciliation Report" as UC_Reconcile
  usecase "Maintain Audit Log" as UC_Audit
}

Support --> UC_Search
Support --> UC_History
Support --> UC_Block
Support --> UC_Unblock
Support --> UC_ReviewRefund
Support --> UC_ApproveRefund
Support --> UC_Reconcile

UC_ApproveRefund .> UC_ReviewRefund : <<include>>
UC_Refund .> UC_ApproveRefund : <<include>>
UC_Block .> UC_Audit : <<include>>
UC_Unblock .> UC_Audit : <<include>>
UC_ApproveRefund .> UC_Audit : <<include>>

@enduml
